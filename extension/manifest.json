{
  "manifest_version": 3,
  "name": "Outfit Finder",
  "description": "Capture what you see and find similar fashion items.",
  "version": "0.1.0",
  "permissions": ["activeTab", "tabs", "storage", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_title": "Outfit Finder",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html"
}
